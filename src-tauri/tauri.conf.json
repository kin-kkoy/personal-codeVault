{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Vault",
  "version": "0.1.0",
  "identifier": "com.makkaon.codevault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Code Vault",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/previews/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
